generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Idea {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  refreshTokens       RefreshToken[]
  ideas               Idea[]
  passwordResetTokens PasswordResetToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Set when this token is rotated out, pointing at its replacement. A token
  // that is presented again after being replaced means the cookie leaked, so
  // the whole family is revoked (OAuth 2.0 BCP refresh token reuse detection).
  replacedById String?      @unique
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("TokenRotation")

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}
